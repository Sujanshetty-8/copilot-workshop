---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <script is:inline>
            try {
                if (localStorage.getItem('tailspin-high-contrast') === 'true') {
                    document.documentElement.classList.add('high-contrast');
                }
            } catch {
                // Storage may be unavailable; the default theme remains usable.
            }
        </script>
    </head>
    <body class="min-h-screen bg-slate-900 text-white transition-colors duration-300 m-0 w-full h-full font-sans">
        <a
            href="#main-content"
            class="absolute left-2 top-2 z-50 -translate-y-20 rounded-lg bg-blue-600 px-4 py-3 text-white focus:translate-y-0 focus:outline-none focus:ring-2 focus:ring-blue-300 motion-reduce:transition-none"
            data-testid="skip-to-content"
        >Skip to content</a>
        <Header />
        <main id="main-content" class="container mx-auto py-6 h-full max-w-7xl">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
    
    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }
    
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    html.high-contrast body {
        background-color: #000;
        color: #fff;
    }

    html.high-contrast header {
        background-color: #000;
        border-bottom: 2px solid #fff;
    }

    html.high-contrast a,
    html.high-contrast button {
        outline-offset: 3px;
    }

    html.high-contrast a:focus-visible,
    html.high-contrast button:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
    }

    html.high-contrast [class~="bg-slate-900"],
    html.high-contrast [class~="bg-slate-800"],
    html.high-contrast [class~="bg-white"] {
        background-color: #000 !important;
    }

    html.high-contrast [class~="text-slate-100"],
    html.high-contrast [class~="text-slate-200"],
    html.high-contrast [class~="text-slate-300"],
    html.high-contrast [class~="text-slate-400"],
    html.high-contrast [class~="text-slate-800"],
    html.high-contrast [class~="text-white"] {
        color: #fff !important;
    }

    html.high-contrast [class~="text-blue-300"],
    html.high-contrast [class~="text-blue-400"],
    html.high-contrast [class~="text-blue-500"],
    html.high-contrast [class~="text-blue-600"] {
        color: #7dd3fc !important;
    }

    html.high-contrast [class~="border-slate-600"],
    html.high-contrast [class~="border-slate-700"] {
        border-color: #fff !important;
    }

    html.high-contrast [class~="bg-blue-500"],
    html.high-contrast [class~="bg-blue-600"],
    html.high-contrast [class~="bg-blue-700"] {
        background-color: #000 !important;
        border: 2px solid #fff;
    }

    html.high-contrast [class~="bg-blue-500\/20"] {
        background-color: #000 !important;
        border: 1px solid #fff;
    }
</style>
